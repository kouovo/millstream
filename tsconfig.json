{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Dev-only: resolve sibling packages to their TS sources. Published packages only expose ./dist.
    "paths": {
      "@millstream/pg/kysely": ["./packages/pg/src/kysely.ts"],
      "@millstream/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "vitest.config.ts"]
}
