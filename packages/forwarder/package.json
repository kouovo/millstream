{
  "name": "@millstream/forwarder",
  "version": "0.2.0",
  "description": "Outbox forwarder for @millstream: envelope publisher + relay handler",
  "keywords": [
    "forwarder",
    "messaging",
    "outbox",
    "watermill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouovo/millstream.git",
    "directory": "packages/forwarder"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@millstream/core": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  }
}
