{
  "name": "@millstream/kafka",
  "version": "0.5.0",
  "description": "Apache Kafka Publisher/Subscriber for @millstream (on @platformatic/kafka): commit on ack, in-place redelivery on nack, per-partition ordering",
  "keywords": [
    "consumer-group",
    "kafka",
    "messaging",
    "pubsub",
    "watermill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouovo/millstream.git",
    "directory": "packages/kafka"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts"
  },
  "dependencies": {
    "@millstream/core": "workspace:^"
  },
  "devDependencies": {
    "@millstream/forwarder": "workspace:^",
    "@millstream/test-kit": "workspace:^",
    "@platformatic/kafka": "^2.15.0"
  },
  "peerDependencies": {
    "@platformatic/kafka": "^2.3.0"
  },
  "engines": {
    "node": "^22.22.0 || >=24.6.0"
  }
}
