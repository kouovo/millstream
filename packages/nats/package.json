{
  "name": "@millstream/nats",
  "version": "0.3.0",
  "description": "NATS JetStream Publisher/Subscriber for @millstream: Nats-Msg-Id dedup, durable consumers as consumer groups, ack/nak with delay",
  "keywords": [
    "jetstream",
    "messaging",
    "nats",
    "pubsub",
    "watermill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouovo/millstream.git",
    "directory": "packages/nats"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts"
  },
  "dependencies": {
    "@millstream/core": "workspace:^"
  },
  "devDependencies": {
    "@millstream/forwarder": "workspace:^",
    "@millstream/test-kit": "workspace:^",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0"
  },
  "peerDependencies": {
    "@nats-io/jetstream": "^3.0.0",
    "@nats-io/nats-core": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
