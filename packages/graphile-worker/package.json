{
  "name": "@millstream/graphile-worker",
  "version": "0.5.0",
  "description": "Graphile Worker (PostgreSQL job queue) Publisher/Subscriber for @millstream: transactional add_job, job_key dedup, run_at delays, nack → Graphile retries with backoff",
  "keywords": [
    "graphile-worker",
    "jobs",
    "messaging",
    "postgres",
    "queue",
    "watermill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouovo/millstream.git",
    "directory": "packages/graphile-worker"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts"
  },
  "dependencies": {
    "@millstream/core": "workspace:^"
  },
  "devDependencies": {
    "@millstream/forwarder": "workspace:^",
    "@millstream/pg": "workspace:^",
    "@millstream/test-kit": "workspace:^",
    "graphile-worker": "^0.18.0",
    "pg": "^8.16.0"
  },
  "peerDependencies": {
    "graphile-worker": "^0.16.0 || ^0.17.0 || ^0.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
