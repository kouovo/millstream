{
  "name": "@millstream/bullmq",
  "version": "0.3.0",
  "description": "BullMQ (Redis) Publisher/Subscriber for @millstream: jobId dedup, native delays, nack → redeliver or BullMQ attempts/backoff",
  "keywords": [
    "bullmq",
    "jobs",
    "messaging",
    "queue",
    "redis",
    "watermill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouovo/millstream.git",
    "directory": "packages/bullmq"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts"
  },
  "dependencies": {
    "@millstream/core": "workspace:^"
  },
  "devDependencies": {
    "@millstream/forwarder": "workspace:^",
    "@millstream/test-kit": "workspace:^",
    "bullmq": "^5.0.0"
  },
  "peerDependencies": {
    "bullmq": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
