{
  "name": "@millstream/core",
  "version": "0.4.0",
  "description": "Watermill-style messaging for TypeScript: Message with Ack/Nack, Publisher/Subscriber, Router + middlewares, in-memory Pub/Sub",
  "keywords": [
    "event-driven",
    "messaging",
    "middleware",
    "pubsub",
    "router",
    "watermill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouovo/millstream.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
