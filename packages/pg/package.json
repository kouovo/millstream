{
  "name": "@millstream/pg",
  "version": "0.3.0",
  "description": "PostgreSQL Pub/Sub for @millstream (node-postgres, postgres.js or Kysely): transactional outbox, xid8-ordered log subscriber, SKIP LOCKED queue, inbox, delayed requeue",
  "keywords": [
    "inbox",
    "kysely",
    "node-postgres",
    "outbox",
    "postgres",
    "postgres.js",
    "postgresql",
    "pubsub",
    "queue",
    "watermill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouovo/millstream.git",
    "directory": "packages/pg"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kysely": {
      "types": "./dist/kysely.d.ts",
      "default": "./dist/kysely.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts"
  },
  "dependencies": {
    "@millstream/core": "workspace:^"
  },
  "devDependencies": {
    "@millstream/cqrs": "workspace:^",
    "@millstream/forwarder": "workspace:^",
    "@millstream/test-kit": "workspace:^",
    "kysely": "^0.29.8",
    "pg": "^8.16.0",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "kysely": ">=0.27.0",
    "pg": "^8.11.0",
    "postgres": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
