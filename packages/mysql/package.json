{
  "name": "@millstream/mysql",
  "version": "0.3.0",
  "description": "MySQL Pub/Sub for @millstream (mysql2 or Kysely): transactional outbox, SKIP LOCKED queue, inbox, delayed requeue",
  "keywords": [
    "inbox",
    "kysely",
    "mysql",
    "mysql2",
    "outbox",
    "pubsub",
    "queue",
    "watermill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouovo/millstream.git",
    "directory": "packages/mysql"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kysely": {
      "types": "./dist/kysely.d.ts",
      "default": "./dist/kysely.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts"
  },
  "dependencies": {
    "@millstream/core": "workspace:^"
  },
  "devDependencies": {
    "@millstream/forwarder": "workspace:^",
    "@millstream/test-kit": "workspace:^",
    "kysely": "^0.29.8",
    "mysql2": "^3.14.0"
  },
  "peerDependencies": {
    "kysely": ">=0.27.0",
    "mysql2": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
